# Supabase — عرّف المشروع في لوحة Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# مفتاح المتصفح (anon أو publishable حسب لوحة Supabase)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-or-anon-key
# أو: NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# يُستخدم فقط على الخادم (Server Components / Server Actions). لا تُضمَّن في العميل.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Prisma 6 + Supabase pooler (استبدل كلمة المرور من لوحة Supabase → Connect)
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@REGION.pooler.supabase.com:5432/postgres"

# ----- Phase 2b — DASM JWT (اختياري؛ الافتراضي بدون إنفاذ) -----
# التدريج: staging ثم الإنتاج — انظر docs/JWT_ROLLOUT.md
# ضع true لتفعيل middleware على مسارات التطبيق الرئيسية
# DASM_JWT_ENFORCE=false
#
# عند true: يقبل JWT موقّعاً أو توكن Sanctum من POST api.dasm.com.sa/api/login
# (كوكي dasm_access_token) مع التحقق عبر DASM_API_URL + /api/user/profile

# إلزامي عند DASM_JWT_ENFORCE=true
# DASM_JWT_ISSUER=https://auth.dasm.example

# اختياري — يُتحقق من aud عند التعريف
# DASM_JWT_AUDIENCE=inspection

# HS256: سر مشترك (تطوير / بعض تكاملات البوابة)
# DASM_JWT_SECRET=

# أو RS256/ES256: عنوان JWKS (يفضّل للإنتاج)
# DASM_JWKS_URI=https://auth.dasm.example/.well-known/jwks.json

# كوكي بديلة لـ Bearer (اسم الكوكي)
# DASM_JWT_COOKIE_NAME=dasm_access_token

# --- مرفقات الفحص (Storage خاص؛ روابط تحميل موقّعة من الخادم) ---
# الاسم يطابق الهجرة الافتراضية في supabase/migrations
# INSPECTION_ATTACHMENTS_BUCKET=inspection-attachments
# INSPECTION_ATTACHMENT_SIGNED_URL_TTL_SEC=3600

# بوابة DASM + REST v1: تحقق الملف الشخصي لـ Bearer (إنشاء/قراءة طلبات)
# DASM_API_URL=https://api.dasm.com.sa
# دفع تقرير معتمد إلى Core (نفس قيمة DASM_INSPECTION_INTERNAL_PULL_TOKEN على Render)
# DASM_CORE_API_URL=https://api.dasm.com.sa
# DASM_INSPECTION_INTERNAL_PULL_TOKEN=
# DASM_INSPECTION_SYNC_ENABLED=true
# INSPECTION_PUBLIC_BASE_URL=https://inspect.dasm.com.sa
# مفاتيح متعددة مفصولة بفاصلة (X-Dasm-Api-Key أو Authorization: ApiKey …)
# DASM_GATEWAY_API_KEYS=key-one,key-two

# بعد نجاح GET /api/gateway?token=… يُضبط كوكي httpOnly اسمُه inspection_dasm_user_id لصفحة «طلباتي»

# حدّ المعدّل لإنشاء الطلبات (طلبات/دقيقة لكل بصمة مفتاح API + IP). ≤0 يعطّل.
# INSPECTION_CREATE_RATE_LIMIT_PER_MIN=60
